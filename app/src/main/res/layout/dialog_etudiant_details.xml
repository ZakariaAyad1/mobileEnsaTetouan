<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- En-tête -->
        <TextView
            android:id="@+id/tv_detail_nom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom Étudiant"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:paddingBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="16dp"/>

        <!-- Section Informations Personnelles -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Informations Personnelles"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:paddingBottom="8dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_detail_cne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CNE: R123456789"
                    android:textSize="14sp"
                    android:paddingVertical="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email: email@ensa.ma"
                    android:textSize="14sp"
                    android:paddingVertical="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_date_naissance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date naissance: 01/01/2000"
                    android:textSize="14sp"
                    android:paddingVertical="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_lieu_naissance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lieu naissance: Tétouan"
                    android:textSize="14sp"
                    android:paddingVertical="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section Scolarité -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎓 Scolarité"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:paddingBottom="8dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_detail_filiere"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Filière: Génie Informatique"
                    android:textSize="14sp"
                    android:paddingVertical="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_annee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Année: 3ème année"
                    android:textSize="14sp"
                    android:paddingVertical="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_nb_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Modules évalués: 0"
                    android:textSize="14sp"
                    android:paddingVertical="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_moyenne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Moyenne générale: 0.00 / 20"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:paddingVertical="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section Notes par Module -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Notes par Module"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:paddingBottom="8dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_notes_etudiant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:padding="8dp"/>

        </androidx.cardview.widget.CardView>

        <!-- Boutons d'action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_edit_etudiant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✏️ Modifier"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_delete_etudiant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗑️ Supprimer"
                android:backgroundTint="@android:color/holo_red_dark"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_close_dialog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fermer"
                style="?android:attr/buttonBarButtonStyle"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>