<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_demande_cne"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CNE: R123456789"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/tv_demande_nom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nom Prénom"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_demande_statut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN_ATTENTE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@android:drawable/dialog_holo_light_frame" />
        </LinearLayout>

        <!-- Type de demande -->
        <TextView
            android:id="@+id/tv_demande_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type de demande"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp" />

        <!-- Détails -->
        <TextView
            android:id="@+id/tv_demande_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Détails de la demande"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="8dp" />

        <!-- Date -->
        <TextView
            android:id="@+id/tv_demande_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date: 2025-01-01"
            android:textSize="11sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="12dp" />

        <!-- Boutons d'action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_rejeter"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Rejeter"
                android:textSize="12sp"
                android:backgroundTint="#D32F2F"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_valider"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Valider"
                android:textSize="12sp"
                android:backgroundTint="#388E3C" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>